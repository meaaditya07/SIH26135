# ─── PostgreSQL ───
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=skilltrace
POSTGRES_PASSWORD=skilltrace_dev_secret
POSTGRES_DB=skilltrace

# ─── Redis ───
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ─── Backend ───
SECRET_KEY=change-me-to-a-64-char-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_URL=http://localhost:8000

# ─── Auth ───
JWT_ALGORITHM=HS256

# ─── DigiLocker ───
DIGILOCKER_CLIENT_ID=your_client_id
DIGILOCKER_CLIENT_SECRET=your_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/v1/auth/digilocker/callback
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1

# ─── Twilio (WhatsApp + SMS) ───
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+15005550001

# ─── MSG91 SMS ───
MSG91_AUTH_KEY=your_msg91_key
MSG91_SENDER_ID=STTRACE

# ─── Survey Dispatch ───
TWILIO_WEBHOOK_SECRET=your_twilio_webhook_secret
SURVEY_CHANNEL_PREFERENCE=whatsapp
SURVEY_SMS_FALLBACK=true
SURVEY_RETRY_DAYS=2
SURVEY_MAX_ATTEMPTS=3
SURVEY_EXPIRY_DAYS=14
PUBLIC_APP_BASE_URL=http://localhost:3000

# ─── Job Scrapers ───
INDEED_PUBLISHER_ID=your_indeed_publisher_id
JOB_SCRAPE_MAX_PER_SECTOR=25

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=SkillTrace AI

# ─── Celery ───
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── Elasticsearch ───
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── MLflow ───
MLFLOW_TRACKING_URI=http://localhost:5000
